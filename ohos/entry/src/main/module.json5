{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone", "tablet", "2in1"
    ],
    "compressNativeLibs": true,
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:icon",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:icon_startwindow",
        "startWindowBackground": "$color:start_window_background",
        "startWindow": "$profile:start_window",
        "exported": true,
        "orientation": "auto_rotation_restricted",
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home"
            ]
          },
          // kira:// 自定义协议深链（如 kira://open/comic/{pathWord} 打开漫画详情）。
          {
            "actions": ["ohos.want.action.viewData"],
            "entities": ["entity.system.default"],
            "uris": [
              {
                "scheme": "kira"
              }
            ]
          },
          // https 分享链接（App Linking）。落地页 https://{webHost}/c/?w={pathWord}
          // 由 app_router.dart 的 /c 路由重定向到 /comic/:pathWord。
          //
          // 与 Android 的 autoVerify 对应：domainVerify 走鸿蒙自己的域名校验，需要
          //  1. 域名服务器部署 https://kira.caolib.qzz.io/.well-known/applinking.json
          //     （内容是 {"applinking":{"apps":[{"appIdentifier":"<AGC APP ID>"}]}}，
          //      与 Android 的 assetlinks.json 是两份不同的文件）；
          //  2. AGC「增长 > App Linking > 应用链接」创建并发布该域名。
          // 任一步没做，链接只会落到浏览器打开，不会拉起应用。
          {
            "actions": ["ohos.want.action.viewData"],
            "entities": ["entity.system.browsable"],
            "uris": [
              // path 类字段都不带前导斜杠。这里只认 /c 与 /c/xxx：
              //   "path": "c"          → 匹配 /c
              //   "pathStartWith": "c/" → 匹配 /c/...（分享链接形如 /c/?w=xxx）
              // 不用 "pathStartWith": "c"，否则 /comic、/category 之类也会被拉进来。
              {
                "scheme": "https",
                "host": "kira.caolib.qzz.io",
                "path": "c"
              },
              {
                "scheme": "https",
                "host": "kira.caolib.qzz.io",
                "pathStartWith": "c/"
              }
            ],
            "domainVerify": true
          },
        ]
      }
    ],
    "requestPermissions": [
      // 网络：API 请求、图片/压缩包下载（system_grant，无需 reason）。
      {
        "name": "ohos.permission.INTERNET"
      },
      // connectivity_plus 读取当前网络类型；阅读器状态栏用它区分 Wi-Fi/移动网络。
      {
        "name": "ohos.permission.GET_NETWORK_INFO",
        "reason": "$string:network_info_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      },
      // flutter_foreground_task：后台下载长时任务。
      {
        "name": "ohos.permission.KEEP_BACKGROUND_RUNNING",
        "reason": "$string:keep_background_running_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      },
      // gal：把阅读器里的图片存进相册（用户主动保存时申请）。
      {
        "name": "ohos.permission.WRITE_IMAGEVIDEO",
        "reason": "$string:write_imagevideo_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      },
      // 回到前台时读取剪贴板里的分享链接（自动检测开关可关闭）。
      {
        "name": "ohos.permission.READ_PASTEBOARD",
        "reason": "$string:read_pasteboard_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      }
    ]
  }
}